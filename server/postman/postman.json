              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/bulk-resolve?acknowledged_by=admin",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "bulk-resolve"],
              "query": [{ "key": "acknowledged_by", "value": "admin" }]
            },
            "description": "Ek saath multiple alerts resolve (\"Resolve All Active\" button). Permission: `resolve`. Response: { message, count }"
          }
        },
        {
          "name": "POST /api/alerts  (manual raise / drill)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"intrusion\",\n  \"message\": \"Manual drill trigger from Postman\",\n  \"camera_id\": \"CAM-001\",\n  \"location\": \"Sector 12, Gate A\",\n  \"risk_level\": \"high\",\n  \"confidence\": 0.9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/alerts",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts"]
            },
