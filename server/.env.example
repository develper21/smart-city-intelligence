# Server configuration
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:4173

# JWT secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Persistence
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Real-time AI alert simulator
ALERT_SIMULATION=true
ALERT_SIMULATION_INTERVAL_MS=25000
