              "raw": "{\n  \"name\": \"Rajesh Kumar\",\n  \"department\": \"Urban CCTV Command Unit\",\n  \"zone\": \"Zone A - North District\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/me",
