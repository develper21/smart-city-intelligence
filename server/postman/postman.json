        {
          "name": "PUT /api/alerts/:id/resolve",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/resolve?acknowledged_by=admin",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", "resolve"],
              "query": [
                { "key": "acknowledged_by", "value": "admin" }
              ]
            },
            "description": "Alert resolve — status → resolved, resolved_time set. Permission: `resolve` (sirf supervisor/admin).\nCamera warning clear hoti hai agar us camera ka last active alert ye tha.\nOperator token se → 403."
          }
        },
        {
          "name": "POST /api/alerts/bulk-resolve",
          "request": {
