      "item": [
        {
          "name": "GET /api/alerts  (list + filters)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/alerts?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts"],
              "query": [
                { "key": "limit", "value": "20", "description": "Page size (max 500, default 50)" },
                { "key": "offset", "value": "0", "description": "Pagination offset" },
                { "key": "risk_level", "value": "", "description": "low | medium | high | critical", "disabled": true },
                { "key": "event_type", "value": "", "description": "intrusion | violence | unattended | crowd | traffic | fire", "disabled": true },
                { "key": "status", "value": "", "description": "active | investigating | resolved", "disabled": true },
                { "key": "acknowledged", "value": "", "description": "true | false", "disabled": true },
                { "key": "camera_id", "value": "", "description": "e.g. CAM-001", "disabled": true }
              ]
            },
            "description": "Paginated alert list, newest first. Response: { alerts: [...], total, limit, offset }.\n\nAlert object: id, event_ref (ALT-001), event_type, camera_id, location, risk_level, message, confidence, status, acknowledged, acknowledged_by, resolved, alert_time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"alerts array\", () => pm.expect(pm.response.json().alerts).to.be.an(\"array\"));",
